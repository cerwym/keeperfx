{
  "version": "0.2.1",
  "defaults": {
    "autoDiscovery": false
  },
  "configurations": [
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "keeperfx.exe",
      "name": "keeperfx.exe",
      "currentDir": "${workspaceRoot}\\.deploy",
      "args": [ "-level", "00001", "-campaign", "personal", "-nointro", "-alex" ]
    },
    {
      "type": "default",
      "project": "CMakeLists.txt",
      "projectTarget": "keeperfx_hvlog.exe",
      "name": "keeperfx_hvlog.exe",
      "currentDir": "${workspaceRoot}\\.deploy",
      "args": "-level 00001 -campaign personal -nointro -alex"
    }
  ]
}