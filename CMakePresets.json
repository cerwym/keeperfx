{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "displayName": "Basic Config",
            "description": "Basic build using Ninja generator",
            "generator": "Ninja",
            "hidden": true,
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/build/vcpkg-triplets"
            }
        },

        {
            "name": "Debug",
            "displayName": "Config Debug",
            "hidden": true,
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "Release",
            "displayName": "Config Release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },

        {
            "name": "linux-base",
            "displayName": "Linux Base",
            "description": "Base for Linux native builds (vcpkg x64-linux-keeperfx triplet)",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/build/vcpkg-triplets",
                "VCPKG_TARGET_TRIPLET": "x64-linux-keeperfx"
            }
        },

        {
            "name": "MSVC-x64-Base",
            "hidden": true,
            "inherits": "base",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed_x64",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },

        {
            "name": "x64-windows-static-debug",
            "displayName": "MSVC x64 Debug (static)",
            "description": "Windows x64 Debug build with MSVC, static runtime linking",
            "inherits": [ "MSVC-x64-Base", "Debug" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "KEEPERFX_TRACY": "ON"
            }
        },

        {
            "name": "x64-windows-static-release",
            "displayName": "MSVC x64 Release (static)",
            "description": "Windows x64 Release build with MSVC, static runtime linking, optimized",
            "inherits": [ "MSVC-x64-Base", "Release" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "x64-windows-static-debug-asan",
            "displayName": "MSVC x64 Debug + ASan (static)",
            "description": "Windows x64 Debug with AddressSanitizer for catching OOB/UAF bugs",
            "inherits": [ "MSVC-x64-Base", "Debug" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "KEEPERFX_SANITIZERS": "ON"
            }
        },

        {
            "name": "x64-windows-static-reldebug-asan",
            "displayName": "MSVC x64 RelDebug + ASan (static)",
            "description": "Windows x64 RelWithDebInfo with AddressSanitizer (better perf than Debug)",
            "inherits": [ "MSVC-x64-Base", "Release" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "KEEPERFX_SANITIZERS": "ON"
            }
        },

        {
            "name": "cross-base",
            "displayName": "Cross-Compile Base",
            "description": "Base for Docker/Linux cross-compile builds (vcpkg; triplet set per-preset)",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/build/vcpkg-triplets",
                "VCPKG_APPLOCAL_DEPS": "OFF"
            }
        },

        {
            "name": "windows-x86-release",
            "displayName": "Windows x86 Release (Docker/Linux cross-compile)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Cross-compile for Windows x86 from Linux using i686-w64-mingw32. Designed for use inside the keeperfx-build-mingw32 Docker image.",
            "inherits": [ "cross-base", "Release" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "x86-mingw-cross",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/toolchains/mingw32.cmake"
            }
        },

        {
            "name": "windows-x86-debug",
            "displayName": "Windows x86 Debug (Docker/Linux cross-compile)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Cross-compile for Windows x86 from Linux using i686-w64-mingw32, with full debug symbols. For use inside the keeperfx-build-mingw32 Docker image.",
            "inherits": [ "cross-base", "Debug" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "VCPKG_TARGET_TRIPLET": "x86-mingw-cross",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/toolchains/mingw32.cmake"
            }
        },

        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release (Docker/Linux cross-compile)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Cross-compile for Windows x64 from Linux using x86_64-w64-mingw32. Designed for use inside the keeperfx-build-mingw64 Docker image.",
            "inherits": [ "cross-base", "Release" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-cross",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/toolchains/mingw64.cmake"
            }
        },

        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug (Docker/Linux cross-compile)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Cross-compile for Windows x64 from Linux using x86_64-w64-mingw32, with full debug symbols. For use inside the keeperfx-build-mingw64 Docker image.",
            "inherits": [ "cross-base", "Debug" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-cross",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/build/cmake/toolchains/mingw64.cmake"
            }
        },

        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Linux native build using system packages",
            "inherits": [ "linux-base", "Release" ],
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "linux-x64-asan",
            "displayName": "Linux x64 ASAN",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Linux native build with AddressSanitizer + UndefinedBehaviorSanitizer",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "KEEPERFX_SANITIZERS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "wasm-release",
            "displayName": "WebAssembly Release",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Emscripten WebAssembly build",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "3ds-release",
            "displayName": "3DS Release",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo 3DS build using devkitARM",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/3DS.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM_3DS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "vita-release",
            "displayName": "PS Vita Release",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "PlayStation Vita release build using vitaGL",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VITASDK}/share/vita.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM_VITA": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "vita-reldebug",
            "displayName": "PS Vita RelWithDebInfo",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "PlayStation Vita build with debug symbols for crash analysis, using vitaGL",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VITASDK}/share/vita.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "PLATFORM_VITA": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "vita-ubsan",
            "displayName": "PS Vita UBSan",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "PlayStation Vita RelWithDebInfo + UndefinedBehaviorSanitizer (trap-on-error, zero extra RAM overhead)",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VITASDK}/share/vita.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "PLATFORM_VITA": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on",
                "CMAKE_C_FLAGS_INIT": "-fsanitize=undefined -fsanitize-undefined-trap-on-error -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS_INIT": "-fsanitize=undefined -fsanitize-undefined-trap-on-error -fno-omit-frame-pointer"
            }
        },

        {
            "name": "vita-gdb",
            "displayName": "PS Vita GDB (vita-uvdb stub)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "PlayStation Vita Debug build with embedded vita-uvdb GDB stub. Game blocks at startup until arm-vita-eabi-gdb / gdb-multiarch connects on port 1234. Requires kubridge.skprx on the Vita (run Setup Vita uvdb once) and a rebuilt vitasdk Docker image.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VITASDK}/share/vita.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_VITA": "ON",
                "VITA_UVDB": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },


        {
            "name": "vita-debug",
            "displayName": "PS Vita Debug (perf logging)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "PlayStation Vita debug build with startup timing logs and SCE diagnostics, using vitaGL",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VITASDK}/share/vita.toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_VITA": "ON",
                "VITA_PERF_LOG": "ON",
                "VITA_SCE_DIAG": "ON",
                "KFX_DEBUG_MEMORY": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "switch-release",
            "displayName": "Nintendo Switch Release",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo Switch build using devkitA64",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/Switch.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM_SWITCH": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "switch-reldebug",
            "displayName": "Nintendo Switch RelWithDebInfo",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo Switch build with debug symbols for crash analysis",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/Switch.cmake",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "PLATFORM_SWITCH": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "switch-debug",
            "displayName": "Nintendo Switch Debug",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo Switch debug build with full debug symbols",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/Switch.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_SWITCH": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "3ds-reldebug",
            "displayName": "3DS RelWithDebInfo",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo 3DS build with debug symbols for crash analysis",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/3DS.cmake",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "PLATFORM_3DS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "3ds-debug",
            "displayName": "3DS Debug",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo 3DS debug build with full debug symbols",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/3DS.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_3DS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "wii-u-release",
            "displayName": "Nintendo Wii U Release",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo Wii U release build using devkitPPC + WUT",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/WiiU.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM_WII_U": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "wii-u-reldebug",
            "displayName": "Nintendo Wii U RelWithDebInfo",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo Wii U build with debug symbols for crash analysis",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/WiiU.cmake",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "PLATFORM_WII_U": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "wii-u-debug",
            "displayName": "Nintendo Wii U Debug",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "description": "Nintendo Wii U debug build with full debug symbols",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/WiiU.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "PLATFORM_WII_U": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "macos-universal",
            "displayName": "macOS Universal (arm64 + x86_64)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "description": "macOS Universal Binary build targeting both Apple Silicon and Intel, using vcpkg",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed_macos",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "macos-arm64-release",
            "displayName": "macOS arm64 Release (Apple Silicon)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "description": "macOS native build for Apple Silicon only, Release configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed_macos",
                "VCPKG_TARGET_TRIPLET": "arm64-osx",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/build/vcpkg-triplets",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        },

        {
            "name": "macos-x86_64-release",
            "displayName": "macOS x86_64 Release (Intel)",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "description": "macOS native build for Intel only, Release configuration",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/../vcpkg_installed_macos",
                "VCPKG_TARGET_TRIPLET": "x86_64-osx",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/build/vcpkg-triplets",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "on"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Base",
            "hidden": true,
            "jobs": 8,
            "verbose": true,
            "configurePreset": "Debug"
        },

        {
            "name": "StandardLog",
            "hidden": true,
            "inherits": "Base",
            "targets": "keeperfx"
        },

        {
            "name": "windows-x86-release",
            "displayName": "Windows x86 Release",
            "inherits": "StandardLog",
            "configurePreset": "windows-x86-release"
        },

        {
            "name": "windows-x86-debug",
            "displayName": "Windows x86 Debug",
            "inherits": "StandardLog",
            "configurePreset": "windows-x86-debug"
        },

        {
            "name": "x64-windows-static-debug",
            "displayName": "MSVC x64 Debug (static)",
            "inherits": "StandardLog",
            "configurePreset": "x64-windows-static-debug"
        },
        {
            "name": "x64-windows-static-release",
            "displayName": "MSVC x64 Release (static)",
            "inherits": "StandardLog",
            "configurePreset": "x64-windows-static-release"
        },

        {
            "name": "x64-windows-static-debug-asan",
            "displayName": "MSVC x64 Debug + ASan (static)",
            "inherits": "StandardLog",
            "configurePreset": "x64-windows-static-debug-asan"
        },
        {
            "name": "x64-windows-static-reldebug-asan",
            "displayName": "MSVC x64 RelDebug + ASan (static)",
            "inherits": "StandardLog",
            "configurePreset": "x64-windows-static-reldebug-asan"
        },

        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "inherits": "StandardLog",
            "configurePreset": "windows-x64-release"
        },

        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "StandardLog",
            "configurePreset": "windows-x64-debug"
        },

        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "inherits": "StandardLog",
            "configurePreset": "linux-x64-release"
        },

        {
            "name": "linux-x64-asan",
            "displayName": "Linux x64 ASAN",
            "inherits": "Base",
            "configurePreset": "linux-x64-asan"
        },

        {
            "name": "wasm-release",
            "displayName": "WebAssembly Release Build",
            "inherits": "StandardLog",
            "configurePreset": "wasm-release"
        },

        {
            "name": "vita-release",
            "displayName": "PS Vita Release Build",
            "inherits": "StandardLog",
            "configurePreset": "vita-release",
            "targets": ["keeperfx.vpk"]
        },

        {
            "name": "vita-reldebug",
            "displayName": "PS Vita RelWithDebInfo Build",
            "inherits": "StandardLog",
            "configurePreset": "vita-reldebug",
            "targets": ["keeperfx.vpk"]
        },

        {
            "name": "vita-debug",
            "displayName": "PS Vita Debug Build (perf logging)",
            "inherits": "StandardLog",
            "configurePreset": "vita-debug",
            "targets": ["keeperfx.vpk"]
        },

        {
            "name": "vita-ubsan",
            "displayName": "PS Vita UBSan Build",
            "inherits": "StandardLog",
            "configurePreset": "vita-ubsan",
            "targets": ["keeperfx.vpk"]
        },

        {
            "name": "vita-gdb",
            "displayName": "PS Vita GDB Build (vita-uvdb stub)",
            "inherits": "StandardLog",
            "configurePreset": "vita-gdb",
            "targets": ["keeperfx.vpk"]
        },

        {
            "name": "switch-release",
            "displayName": "Nintendo Switch Release Build",
